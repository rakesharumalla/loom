# Copy to .env and adjust. No secrets belong in this file: persona OAuth secrets
# live in the Databricks secret scope LOOM_SECRET_SCOPE (created by scripts/setup.sh).
DATABRICKS_CONFIG_PROFILE=DEFAULT
LOOM_CATALOG=loom_catalog
LOOM_SCHEMA=loom
LOOM_VOLUME=raw
LOOM_LAKEBASE_PROJECT=loom-demo
LOOM_LAKEBASE_BRANCH=production
LOOM_LAKEBASE_DATABASE=databricks_postgres
LOOM_PG_SCHEMA=loom
LOOM_EMBEDDING_ENDPOINT=databricks-gte-large-en
LOOM_EMBEDDING_DIM=1024
LOOM_LLM_ENDPOINT=databricks-claude-sonnet-5-5
LOOM_SECRET_SCOPE=loom-demo
LOOM_SESSION_STORE=loom-sessions
LOOM_INLINE_MAX_BYTES=65536
